# Copia este archivo como .env.local y rellena la clave para ver las reseñas de Google.
# Clave con "Maps JavaScript API" y "Places API (New)" activadas,
# restringida por referentes HTTP (p. ej. http://localhost:3457/* y tu dominio).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Opcional: place ID de la clínica (evita una búsqueda en cada visita).
NEXT_PUBLIC_GOOGLE_PLACE_ID=
